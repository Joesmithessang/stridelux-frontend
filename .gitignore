# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build
/build/.lambda-temp

# Lambda deployment temp files
lambdas/.lambda-temp
/terraform/lambda-placeholder
*.zip

# Terraform — local provider cache and generated plan files
**/.terraform/*
!**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
terraform/plan.txt
terraform/plan_output.txt

# Lambda function node_modules — installed fresh by CI (npm ci --production)
lambdas/*/node_modules/

# misc
.DS_Store
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
